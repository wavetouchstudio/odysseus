+def _mcp_matches_relevant(qualified: str, relevant: set) -> bool:
+    """Match a qualified MCP name (mcp__serverid__toolname) against a set of short names."""
+    if qualified in relevant:
+        return True
+    parts = qualified.split("__", 2)
+    return len(parts) == 3 and parts[2] in relevant
+
+
+def _select_api_tool_schemas(function_schemas, mcp_schemas, relevant_tools, needs_admin):
+    if relevant_tools:
+        base = [s for s in function_schemas
+                if s.get("function", {}).get("name") in relevant_tools]
+        # When caller scopes tools, filter MCP schemas too — sending all 100+ MCP
+        # schemas blows the context window of smaller models (issue: subagent route).
+        filtered_mcp = [s for s in mcp_schemas
+                        if _mcp_matches_relevant(
+                            s.get("function", {}).get("name", ""), relevant_tools)]
+        return base + filtered_mcp
+    elif needs_admin:
+        base = list(function_schemas)
+    else:
+        base = [s for s in function_schemas
+                if s.get("function", {}).get("name") not in _ADMIN_SCHEMA_NAMES]
+    return base + list(mcp_schemas)
+
+
+def _shorten_mcp_schemas(schemas: list) -> tuple:
+    """Rename mcp__serverid__toolname → toolname in schemas sent to the model.
+
+    Small models are confused by UUID-prefixed names and hallucinate tool names
+    instead of using native function calling. Short names fix this without
+    changing execution — the returned mapping is used by _resolve_tool_blocks
+    to expand short names back to qualified names before dispatch.
+
+    Returns (renamed_schemas, short_to_qualified_map).
+    On name collision (two servers with the same short name), the qualified
+    name is kept so the model can still distinguish them.
+    """
+    renamed = []
+    mapping: dict = {}
+    for schema in schemas:
+        fn = schema.get("function", {})
+        name = fn.get("name", "")
+        parts = name.split("__", 2)
+        if len(parts) == 3 and parts[0] == "mcp":
+            short = parts[2]
+            if short in mapping:
+                renamed.append(schema)
+                continue
+            mapping[short] = name
+            renamed.append({**schema, "function": {**fn, "name": short}})
+        else:
+            renamed.append(schema)
+    return renamed, mapping
+
